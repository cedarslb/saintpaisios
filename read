<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Liturgical Readings</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            margin: 0;
            padding: 20px;
        }
        .antiochian-liturgics {
          width: 100%;
          max-width: 1200px;
          margin: 0 auto;
        }

        .antiochian-liturgics iframe {
          display: block;
          width: 100%;
          height: 1100px;
          border: 0;
          border-radius: 8px;
          background: #fff;
        }

        .antiochian-credit {
          margin: 8px 0 0;
          text-align: center;
          font: 13px/1.5 Arial, sans-serif;
          color: #666;
        }

        .antiochian-credit a {
          color: inherit;
        }

        @media (max-width: 768px) {
          .antiochian-liturgics iframe {
            height: 1400px;
          }
        }
    </style>
</head>
<body>

<div class="antiochian-liturgics">
  <iframe
    src="https://www.antiochian.org/liturgicday"
    title="Daily Liturgical Readings - Antiochian Orthodox Christian Archdiocese"
    loading="lazy"
    allowfullscreen>
  </iframe>

  <p class="antiochian-credit">
    Daily liturgical information provided by
    <a href="https://www.antiochian.org/liturgicday"
       target="_blank"
       rel="noopener noreferrer">
      Antiochian Orthodox Christian Archdiocese of North America
    </a>
  </p>
</div>

</body>
</html>
